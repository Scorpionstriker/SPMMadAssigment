<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        App theme. It MUST be a NoActionBar theme because every screen
        provides its own MaterialToolbar and calls setSupportActionBar().
    -->
    <style name="Theme.SmartPantryManager" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_green_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_green_dark</item>
        <item name="colorSecondary">@color/brand_green</item>
        <item name="colorSecondaryContainer">@color/brand_green_light</item>
        <item name="colorOnSecondaryContainer">@color/brand_green_dark</item>
    </style>

    <!-- Reusable style for the section titles on the Settings screen -->
    <style name="SettingsSectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/brand_green</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>